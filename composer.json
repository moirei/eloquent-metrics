{
    "name": "moirei/eloquent-metrics",
    "description": "Retrieve metric data on Eloquent Models for analytics.",
    "homepage": "https://moirei.github.io/eloquent-metrics",
    "license": "MIT",
    "authors": [
        {
            "name": "Augustus",
            "email": "augustusokoye@moirei.com"
        }
    ],
    "keywords":[
        "MOIREI",
        "Laravel",
        "eloquent",
        "metrics",
        "analytics",
        "charts",
        "chart.js",
        "chartisan"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "laravel/helpers": "^1.7",
        "cakephp/chronos": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "MOIREI\\Metrics\\": "src",
            "MOIREI\\Metrics\\Tests\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
  }
